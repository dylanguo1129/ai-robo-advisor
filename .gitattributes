# Normalise line endings in the repository to LF on every platform.
* text=auto eol=lf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.pdf binary
*.xls binary
*.xlsx binary
*.docx binary
*.pkl binary
*.parquet binary

